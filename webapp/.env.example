# Copy to .env (dev) or /etc/garden-web/garden-web.env (server). Never commit the real file.
MQTT_URL=mqtt://localhost:1883
MQTT_USER=webapp
MQTT_PASS=change-me

HOST=127.0.0.1
PORT=3000
DB_PATH=/var/lib/garden-web/garden.db

# Login (one admin account)
ADMIN_USER=admin
# Generate with: npm run hash-password   (paste the whole printed line)
ADMIN_PASS_HASH=scrypt:paste:here
# Random secret that signs session cookies. Generate with: openssl rand -hex 32
# Changing it logs out every device.
SESSION_SECRET=change-me-to-64-hex-chars

# Local testing only: skips login. Never set on the VPS.
# AUTH_DISABLED=1
