# Copy to .env (dev) or /etc/garden/garden.env (server). Never commit the real file.
MQTT_URL=mqtt://localhost:1883
MQTT_USER=webapp
MQTT_PASS=change-me

HOST=127.0.0.1
PORT=3000
DB_PATH=/var/lib/garden/garden.db

# Cloudflare Access (Zero Trust > Access > Applications > your app)
# Team domain, e.g. yourteam.cloudflareaccess.com
CF_TEAM_DOMAIN=yourteam.cloudflareaccess.com
# "Application Audience (AUD) Tag" from the app's Overview tab
CF_AUD=paste-aud-tag-here

# Local testing only: skips the Cloudflare Access check. Never set on the VPS.
# AUTH_DISABLED=1
