[Unit]
Description=Garden watering dashboard
After=network-online.target mosquitto.service
Wants=network-online.target

[Service]
WorkingDirectory=/opt/garden
EnvironmentFile=/etc/garden/garden.env
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=5

# Throwaway unprivileged user; /var/lib/garden is created for it and holds the SQLite DB.
DynamicUser=yes
StateDirectory=garden
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# Keep it small next to the Factorio server.
MemoryMax=200M

[Install]
WantedBy=multi-user.target
